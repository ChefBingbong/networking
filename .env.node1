# Bootstrap / miner node
ETH_NODE_NAME=node1
ETH_DEV=pow
ETH_MINE=true

ETH_DATADIR=./data/node1

# P2P
ETH_PORT=8000
ETH_EXT_IP=127.0.0.1
ETH_DISC_DNS=false
ETH_DISC_V4=true
ETH_SINGLE_NODE=false
# Replace BOOTSTRAP_NODE_ID with node1's actual enode pubkey
ETH_BOOTNODES=

# RPC

# RPC
ETH_RPC=true
ETH_RPC_ADDR=127.0.0.1
ETH_RPC_PORT=8545

# Engine (optional; off by default)
ETH_ENGINE=true
ETH_ENGINE_PORT=8551
ETH_ENGINE_ADDR=127.0.0.1
ETH_ENGINE_AUTH=true
ETH_UNLOCK=./keys/dev-miner.key

# WS (off by default)
ETH_WS=false
ETH_WS_ADDR=127.0.0.1
ETH_WS_PORT=8546

# Metrics
ETH_PROMETHEUS=false
ETH_PROMETHEUS_PORT=9000

# Logging
ETH_LOG_LEVEL=info
ETH_LOG_FILE=./data/node1/ethereumjs.log
ETH_LOG_LEVEL_FILE=debug
ETH_LOG_ROTATE=true
ETH_LOG_MAX_FILES=5
USE_ENV_PEER=true
  PEER_PRIVATE_KEY=0x0c3ce42633d298eababd2bb68aa84119673afbece5fa4019715bd21424355a03
  PEER_PUBLIC_KEY=0x04e0f8756f96bd2f9bed336fe4b7cb015d9297ba91b15323e7d25798ae3fca85ba9c43fcf752b13cff313b2cdfd9a23c43282c07f37131eae8d2dcd48c84c6085d
  PEER_ID=e0f8756f96bd2f9bed336fe4b7cb015d9297ba91b15323e7d25798ae3fca85ba9c43fcf752b13cff313b2cdfd9a23c43282c07f37131eae8d2dcd48c84c6085d