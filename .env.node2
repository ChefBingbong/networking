ETH_NODE_NAME=node2
ETH_DEV=pow
ETH_MINE=false

ETH_DATADIR=./data/node2

# P2P
ETH_PORT=8001
ETH_EXT_IP=127.0.0.1
ETH_DISC_DNS=false
ETH_DISC_V4=true
ETH_SINGLE_NODE=false

# Replace BOOTSTRAP_NODE_ID with node1's actual enode pubkey
ETH_BOOTNODES=enode://e0f8756f96bd2f9bed336fe4b7cb015d9297ba91b15323e7d25798ae3fca85ba9c43fcf752b13cff313b2cdfd9a23c43282c07f37131eae8d2dcd48c84c6085d@127.0.0.1:8000

# RPC
ETH_RPC=true
ETH_RPC_ADDR=127.0.0.1
ETH_RPC_PORT=8546

# Engine (optional)
ETH_ENGINE=true
ETH_ENGINE_PORT=8552
ETH_ENGINE_ADDR=127.0.0.1
ETH_ENGINE_AUTH=true

ETH_WS=false
ETH_WS_ADDR=127.0.0.1
ETH_WS_PORT=8547
ETH_UNLOCK=./keys/dev-miner.key

ETH_PROMETHEUS=true
ETH_PROMETHEUS_PORT=9001
ETH_TX_INTERVAL_MS=20000

ETH_LOG_LEVEL=info
ETH_LOG_FILE=./data/node2/ethereumjs.log
ETH_LOG_LEVEL_FILE=debug
ETH_LOG_ROTATE=true
ETH_LOG_MAX_FILES=5

