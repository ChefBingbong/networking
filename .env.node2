ETH_NODE_NAME=node2
ETH_DEV=pow
ETH_MINE=false

ETH_DATADIR=./data/node2

# P2P
ETH_PORT=8001
ETH_EXT_IP=127.0.0.1
ETH_DISC_DNS=false
ETH_DISC_V4=true
ETH_SINGLE_NODE=false

# Replace BOOTSTRAP_NODE_ID with node1's actual enode pubkey
ETH_BOOTNODES=enode://df40452fa9cffb06a139353f04c00ac6b47d9c5d574bc942d5a6157925219d7f37506ff1eb033e7bae08520c0de0a76bae00d5bcea2f6542224694d27ca96fbc@127.0.0.1:8000

# RPC
ETH_RPC=true
ETH_RPC_ADDR=127.0.0.1
ETH_RPC_PORT=8546

# Engine (optional)
ETH_ENGINE=true
ETH_ENGINE_PORT=8552
ETH_ENGINE_ADDR=127.0.0.1
ETH_ENGINE_AUTH=true

ETH_WS=false
ETH_WS_ADDR=127.0.0.1
ETH_WS_PORT=8547
ETH_UNLOCK=./keys/dev-miner.key

ETH_PROMETHEUS=true
ETH_PROMETHEUS_PORT=9001
ETH_TX_INTERVAL_MS=20000

ETH_LOG_LEVEL=info
ETH_LOG_FILE=./data/node2/ethereumjs.log
ETH_LOG_LEVEL_FILE=debug
ETH_LOG_ROTATE=true
ETH_LOG_MAX_FILES=5
