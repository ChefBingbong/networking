ETH_NODE_NAME=node2
ETH_DEV=pow
ETH_MINE=false

ETH_DATADIR=./data/node2

# P2P
ETH_PORT=8001
ETH_EXT_IP=127.0.0.1
ETH_DISC_DNS=false
ETH_DISC_V4=true
ETH_SINGLE_NODE=false

# Replace BOOTSTRAP_NODE_ID with node1's actual enode pubkey
ETH_BOOTNODES=enode://c7fa43f74b916691e88f4b1f8f8c9b7d7d41c5d89c09afe54bb3b99f2bd8b5a9b2eb0b2ee0ce6a009e077cb82dd39d471a86333010c68b2e2329e5a7fc25c343@127.0.0.1:8000

# RPC
ETH_RPC=true
ETH_RPC_ADDR=127.0.0.1
ETH_RPC_PORT=8546

# Engine (optional)
ETH_ENGINE=true
ETH_ENGINE_PORT=8552
ETH_ENGINE_ADDR=127.0.0.1
ETH_ENGINE_AUTH=true

ETH_WS=false
ETH_WS_ADDR=127.0.0.1
ETH_WS_PORT=8547
ETH_UNLOCK=./keys/dev-miner.key

ETH_PROMETHEUS=true
ETH_PROMETHEUS_PORT=9001
ETH_TX_INTERVAL_MS=20000
ETH_LOG_LEVEL=info
ETH_LOG_FILE=./data/node2/ethereumjs.log
ETH_LOG_LEVEL_FILE=debug
ETH_LOG_ROTATE=true
ETH_LOG_MAX_FILES=5
