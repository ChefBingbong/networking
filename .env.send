# Your miner's RPC endpoint
RPC_URL=http://127.0.0.1:8546

# Devnet chain ID (matches your setupDevnet: 123456)
CHAIN_ID=123456

# Destination address
TO_ADDRESS=0xd647C9620F49d1701e8eE6058F2DB59a0A70a904

# Amount in ETH
AMOUNT_ETH=1.5

# Either provide the private key directly...
# MINER_PRIVATE_KEY=0xabc123...

# ...or point to the same file you use for ETH_UNLOCK
MINER_KEY_FILE=./keys/dev-miner.key

# Optional: wait for confirmation
WAIT_FOR_RECEIPT=true
